{
  "name": "veci",
  "version": "0.1.0-dev",
  "type": "module",
  "description": "VeCI - Vendor-style Easy Configuration Interface for OpenWrt",
  "keywords": [
    "openwrt",
    "ubus",
    "management",
    "ui",
    "theme",
    "vanilla-js",
    "spa",
    "router"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/watch.js qemu",
    "dev:physical": "node scripts/watch.js",
    "deploy": "scp -r veci/* root@192.168.1.1:/www/veci/",
    "build": "node scripts/build.js",
    "format": "prettier --write \"veci/**/*.{js,css,html}\" \"scripts/**/*.js\" \"index.html\"",
    "format:check": "prettier --check \"veci/**/*.{js,css,html}\" \"scripts/**/*.js\" \"index.html\"",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint veci scripts eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "chokidar": "^5.0.0",
    "clean-css": "^5.3.3",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "prettier": "^3.8.1",
    "terser": "^5.36.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aicoach-alpha/veci"
  },
  "packageManager": "pnpm@8.15.9"
}
