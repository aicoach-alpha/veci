config core 'main'
	option profile 'auto'
	option expert_luci '1'
	option apps '1'
	option app_feed_enabled '0'
	option telemetry '0'

config ui 'appearance'
	option theme 'coachassist'
	option density 'comfortable'
	option language 'auto'

# IPv6 off by default in new firmware. Preserved upgrade configs without this
# section keep their current network state until explicitly changed in VeCI.
config ipv6 'ipv6'
	option enabled '0'
