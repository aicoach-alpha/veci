config core 'main'
	option profile 'auto'
	option expert_luci '1'
	option apps '1'
	option telemetry '0'

config ui 'appearance'
	option theme 'coachassist'
	option density 'comfortable'
	option language 'auto'

# Fresh VeCI installs start IPv4-only. Existing upgrades without this section
# are left untouched until the operator explicitly selects a mode.
config ipv6 'ipv6'
	option enabled '0'
