#!/bin/sh

clean_token() {
	printf '%s' "$1" | tr -cd 'A-Za-z0-9._:-'
}

clean_text() {
	printf '%s' "$1" | tr -cd 'A-Za-z0-9 ._:/()%+-'
}

json_bool_file() {
	[ -e "$1" ] && printf true || printf false
}

method_capabilities() {
	opennds=$(json_bool_file /etc/config/opennds)
	sqm=$(json_bool_file /etc/config/sqm)
	ddns=$(json_bool_file /etc/config/ddns)
	if command -v wg >/dev/null 2>&1 || grep -qs "option proto 'wireguard'" /etc/config/network; then
		wireguard=true
	else
		wireguard=false
	fi
	if ubus list 2>/dev/null | grep -qx 'veci.voucher'; then
		voucher=true
	else
		voucher=false
	fi
	if ubus list 2>/dev/null | grep -qx 'veci.cellular'; then
		cellular=true
	else
		cellular=false
	fi
	printf '{ "opennds": %s, "sqm": %s, "ddns": %s, "wireguard": %s, "voucher": %s, "cellular": %s }\\n' \
		"$opennds" "$sqm" "$ddns" "$wireguard" "$voucher" "$cellular"
}

method_clients() {
	now=$(date +%s)
	items=''
	if [ -f /tmp/dhcp.leases ]; then
		while read -r expiry mac ip host _; do
			mac=$(clean_token "$mac")
			ip=$(clean_token "$ip")
			host=$(clean_token "$host")
			[ -n "$ip" ] || continue
			[ "$host" = "*" ] && host=''
			if [ "$expiry" -gt 0 ] 2>/dev/null; then
				remaining=$((expiry - now))
				[ "$remaining" -lt 0 ] && remaining=0
			else
				remaining=0
			fi
			item="{ \"expires\": $remaining, \"macaddr\": \"$mac\", \"ipaddr\": \"$ip\", \"hostname\": \"$host\" }"
			items="${items:+$items, }$item"
		done < /tmp/dhcp.leases
	fi
	printf '{ "clients": [ %s ] }\n' "$items"
}

method_network_inventory() {
	bridges=''
	ports=''

	for path in /sys/class/net/*; do
		[ -e "$path" ] || continue
		name=$(clean_token "${path##*/}")
		[ -n "$name" ] || continue

		if [ -d "$path/bridge" ]; then
			members=''
			for member_path in "$path/brif/"*; do
				[ -e "$member_path" ] || continue
				member=$(clean_token "${member_path##*/}")
				[ -n "$member" ] || continue
				members="${members:+$members, }\"$member\""
			done
			bridge="{ \"name\": \"$name\", \"members\": [ $members ] }"
			bridges="${bridges:+$bridges, }$bridge"
			continue
		fi

		[ "$name" = "lo" ] && continue
		[ -e "$path/phy80211" ] && continue
		[ -e "$path/device" ] || continue
		ports="${ports:+$ports, }\"$name\""
	done

	printf '{ "bridges": [ %s ], "ports": [ %s ] }\n' "$bridges" "$ports"
}

method_health() {
	overlay='unavailable'
	if command -v df >/dev/null 2>&1; then
		overlay=$(df -h /overlay 2>/dev/null | awk 'NR==2 { printf "%s used / %s total (%s)", $3, $2, $5 }')
		[ -n "$overlay" ] || overlay='unavailable'
	fi
	overlay=$(clean_text "$overlay")
	printf '{ "overlay": "%s" }\n' "$overlay"
}

method_internet_status() {
	cache=/tmp/veci-internet-status
	now=$(date +%s)

	if [ -r "$cache" ]; then
		read -r stamp state target < "$cache" || true
		case "$stamp" in
			*[!0-9]*|'') ;;
			*)
				age=$((now - stamp))
				if [ "$age" -ge 0 ] && [ "$age" -lt 10 ]; then
					case "$state" in
						reachable) printf '{ "status": "reachable", "reachable": true, "probe": "icmp", "target": "%s", "cached": true }\n' "$target"; return ;;
						unreachable) printf '{ "status": "unreachable", "reachable": false, "probe": "icmp", "cached": true }\n'; return ;;
					esac
				fi
				;;
		esac
	fi

	command -v ping >/dev/null 2>&1 || {
		printf '{ "status": "unknown", "reachable": null, "probe": "unavailable", "cached": false }\n'
		return
	}

	for target in 1.1.1.1 8.8.8.8; do
		if ping -c 1 -W 1 "$target" >/dev/null 2>&1; then
			printf '%s reachable %s\n' "$now" "$target" > "$cache"
			printf '{ "status": "reachable", "reachable": true, "probe": "icmp", "target": "%s", "cached": false }\n' "$target"
			return
		fi
	done

	printf '%s unreachable -\n' "$now" > "$cache"
	printf '{ "status": "unreachable", "reachable": false, "probe": "icmp", "cached": false }\n'
}


method_update_status() {
	release='unknown'
	revision='unknown'
	repository_channel='unknown'
	package_updates=0
	sensitive_updates=0
	kernel_feed_mismatch=false
	custom_feed_configured=false
	owut_available=false

	if [ -r /etc/openwrt_release ]; then
		release=$(sed -n "s/^DISTRIB_RELEASE='\\(.*\\)'/\\1/p" /etc/openwrt_release | head -n 1)
		revision=$(sed -n "s/^DISTRIB_REVISION='\\(.*\\)'/\\1/p" /etc/openwrt_release | head -n 1)
		[ -n "$release" ] || release='unknown'
		[ -n "$revision" ] || revision='unknown'
	fi

	repositories=''
	for repo_file in /etc/apk/repositories /etc/apk/repositories.d/*.list; do
		[ -r "$repo_file" ] || continue
		repositories="$repositories
$(cat "$repo_file" 2>/dev/null)"
	done

	has_release=false
	has_snapshot=false
	printf '%s\n' "$repositories" | grep -Eq '/releases/|packages-25\\.12' && has_release=true || true
	printf '%s\n' "$repositories" | grep -Eq '/snapshots/|25\\.12-SNAPSHOT' && has_snapshot=true || true
	if [ "$has_release" = true ] && [ "$has_snapshot" = true ]; then
		repository_channel='mixed'
	elif [ "$has_snapshot" = true ]; then
		repository_channel='snapshot'
	elif [ "$has_release" = true ]; then
		repository_channel='release'
	fi

	if command -v apk >/dev/null 2>&1; then
		tmp="/tmp/veci-upgradeable.$"
		apk list --upgradeable > "$tmp" 2>/dev/null || true
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			package_updates=$((package_updates + 1))
			case "$line" in
				kernel-*|kmod-*|base-files-*|busybox-*|libc-*|libubox-*|libubus-*|libuci-*|libblobmsg-json-*|procd-*|rpcd-*|netifd-*|ucode-*|uhttpd-*|hostapd-*|wpad-*|firewall4-*|nftables-*|dnsmasq-*|odhcp*|ppp-*|apk-*|fstools-*)
					sensitive_updates=$((sensitive_updates + 1))
					;;
			esac
		done < "$tmp"
		rm -f "$tmp"
	fi

	if command -v apk >/dev/null 2>&1 && apk list --upgradeable kernel 2>/dev/null | grep -q '^kernel-'; then
		kernel_feed_mismatch=true
	fi

	for custom_file in /etc/apk/repositories.d/customfeeds.list /etc/apk/repositories.d/customfeeds.dist; do
		[ -r "$custom_file" ] || continue
		if grep -Eq '^[[:space:]]*https?://' "$custom_file"; then
			custom_feed_configured=true
			break
		fi
	done

	command -v owut >/dev/null 2>&1 && owut_available=true

	. /usr/share/libubox/jshn.sh
	json_init
	json_add_string release "$(clean_text "$release")"
	json_add_string revision "$(clean_text "$revision")"
	json_add_string repository_channel "$repository_channel"
	json_add_int package_updates "$package_updates"
	json_add_int sensitive_updates "$sensitive_updates"
	[ "$kernel_feed_mismatch" = true ] && json_add_boolean kernel_feed_mismatch 1 || json_add_boolean kernel_feed_mismatch 0
	[ "$custom_feed_configured" = true ] && json_add_boolean custom_feed_configured 1 || json_add_boolean custom_feed_configured 0
	[ "$owut_available" = true ] && json_add_boolean owut_available 1 || json_add_boolean owut_available 0
	json_add_string upgrade_policy "firmware_image_only"
	json_dump
}

package_manager() {
	if command -v apk >/dev/null 2>&1; then
		printf 'apk'
	elif command -v opkg >/dev/null 2>&1; then
		printf 'opkg'
	else
		printf 'none'
	fi
}

package_installed() {
	case "$(package_manager)" in
		apk) apk info -e "$1" >/dev/null 2>&1 ;;
		opkg) opkg status "$1" 2>/dev/null | grep -q '^Status: install ok installed$' ;;
		*) return 1 ;;
	esac
}

app_feed_enabled() {
	[ "$(uci -q get veci.main.app_feed_enabled 2>/dev/null)" = "1" ]
}

manifest_packages() {
	jsonfilter -i "$1" -e '@.packages[*]' 2>/dev/null
}

manifest_remove_packages() {
	jsonfilter -i "$1" -e '@.remove_packages[*]' 2>/dev/null
}

safe_package_words() {
	for package in "$@"; do
		safe=$(clean_token "$package")
		[ -n "$package" ] && [ "$safe" = "$package" ] || return 1
	done
}

method_apps() {
	manager=$(package_manager)
	feed_enabled=false
	app_feed_enabled && feed_enabled=true
	items=''

	for manifest in /usr/share/veci/apps/*.json; do
		[ -r "$manifest" ] || continue

		id=$(jsonfilter -i "$manifest" -e '@.id' 2>/dev/null)
		name=$(jsonfilter -i "$manifest" -e '@.name' 2>/dev/null)
		description=$(jsonfilter -i "$manifest" -e '@.description' 2>/dev/null)
		tier=$(jsonfilter -i "$manifest" -e '@.tier' 2>/dev/null)
		enabled_value=$(jsonfilter -i "$manifest" -e '@.enabled' 2>/dev/null)
		id=$(clean_token "$id")
		name=$(clean_text "$name")
		description=$(clean_text "$description")
		tier=$(clean_token "$tier")
		case "$enabled_value" in
			false|0) enabled=false ;;
			*) enabled=true ;;
		esac
		[ -n "$id" ] || continue

		installed=true
		packages=''
		while IFS= read -r package; do
			[ -n "$package" ] || continue
			safe=$(clean_token "$package")
			[ "$safe" = "$package" ] || continue
			packages="${packages:+$packages, }\"$package\""
			package_installed "$package" || installed=false
		done <<EOF
$(manifest_packages "$manifest")
EOF

		removable=false
		[ -n "$(manifest_remove_packages "$manifest")" ] && removable=true

		installable=false
		if [ "$enabled" = true ] && [ "$installed" = false ] && [ "$feed_enabled" = true ] && [ "$manager" != "none" ]; then
			installable=true
		fi

		item="{ \"id\": \"$id\", \"name\": \"$name\", \"description\": \"$description\", \"tier\": \"$tier\", \"packages\": [ $packages ], \"enabled\": $enabled, \"installed\": $installed, \"installable\": $installable, \"removable\": $removable }"
		items="${items:+$items, }$item"
	done

	printf '{ "package_manager": "%s", "feed_enabled": %s, "apps": [ %s ] }\n' "$manager" "$feed_enabled" "$items"
}

method_app_action() {
	input=$(cat)
	id=$(printf '%s' "$input" | jsonfilter -e '@.id' 2>/dev/null)
	action=$(printf '%s' "$input" | jsonfilter -e '@.action' 2>/dev/null)
	safe_id=$(clean_token "$id")

	[ -n "$id" ] && [ "$safe_id" = "$id" ] || {
		printf '{ "ok": false, "error": "invalid_app_id" }\n'
		return
	}

	manifest="/usr/share/veci/apps/$id.json"
	[ -r "$manifest" ] || {
		printf '{ "ok": false, "error": "app_not_catalogued" }\n'
		return
	}

	manager=$(package_manager)
	[ "$manager" != "none" ] || {
		printf '{ "ok": false, "error": "package_manager_unavailable" }\n'
		return
	}

	case "$action" in
		install)
			enabled_value=$(jsonfilter -i "$manifest" -e '@.enabled' 2>/dev/null)
			case "$enabled_value" in
				false|0)
					printf '{ "ok": false, "error": "app_disabled" }\n'
					return
					;;
			esac
			app_feed_enabled || {
				printf '{ "ok": false, "error": "app_feed_disabled" }\n'
				return
			}
			package_lines=$(manifest_packages "$manifest")
			;;
		remove)
			package_lines=$(manifest_remove_packages "$manifest")
			[ -n "$package_lines" ] || {
				printf '{ "ok": false, "error": "app_removal_not_supported" }\n'
				return
			}
			;;
		*)
			printf '{ "ok": false, "error": "unsupported_app_action" }\n'
			return
			;;
	esac

	set --
	while IFS= read -r package; do
		[ -n "$package" ] || continue
		set -- "$@" "$package"
	done <<EOF
$package_lines
EOF

	[ "$#" -gt 0 ] && safe_package_words "$@" || {
		printf '{ "ok": false, "error": "invalid_package_manifest" }\n'
		return
	}

	rc=1
	case "$manager:$action" in
		apk:install)
			apk add "$@" >/tmp/veci-app-action.log 2>&1
			rc=$?
			;;
		apk:remove)
			apk del "$@" >/tmp/veci-app-action.log 2>&1
			rc=$?
			;;
		opkg:install)
			opkg update >/tmp/veci-app-action.log 2>&1 && opkg install "$@" >>/tmp/veci-app-action.log 2>&1
			rc=$?
			;;
		opkg:remove)
			opkg remove "$@" >/tmp/veci-app-action.log 2>&1
			rc=$?
			;;
	esac

	if [ "$rc" -eq 0 ]; then
		printf '{ "ok": true, "id": "%s", "action": "%s" }\n' "$id" "$action"
	else
		printf '{ "ok": false, "error": "package_action_failed", "id": "%s", "action": "%s" }\n' "$id" "$action"
	fi
}

firmware_channel_url() {
	uci -q get veci.main.firmware_channel_url 2>/dev/null
}

firmware_channel_sig_url() {
	uci -q get veci.main.firmware_channel_sig_url 2>/dev/null
}

firmware_channel_pubkey() {
	uci -q get veci.main.firmware_channel_pubkey 2>/dev/null
}

firmware_apply_enabled() {
	[ "$(uci -q get veci.main.firmware_apply_enabled 2>/dev/null)" = "1" ]
}

firmware_max_bytes() {
	value=$(uci -q get veci.main.firmware_max_bytes 2>/dev/null)
	case "$value" in
		''|*[!0-9]*) printf '0' ;;
		*) printf '%s' "$value" ;;
	esac
}

firmware_live_board() {
	ubus call system board 2>/dev/null | jsonfilter -e '@.board_name' 2>/dev/null
}

firmware_current_build_id() {
	[ -r /etc/veci-release.json ] || return
	jsonfilter -i /etc/veci-release.json -e '@.build_id' 2>/dev/null
}

firmware_auto_check_enabled() {
	[ "$(uci -q get veci.main.firmware_auto_check 2>/dev/null)" = "1" ]
}

firmware_auto_interval_seconds() {
	hours=$(uci -q get veci.main.firmware_auto_interval_hours 2>/dev/null)
	case "$hours" in
		''|*[!0-9]*) hours=24 ;;
	esac
	[ "$hours" -ge 1 ] 2>/dev/null || hours=1
	[ "$hours" -le 168 ] 2>/dev/null || hours=168
	printf '%s' "$((hours * 3600))"
}

firmware_auto_due() {
	now=$(date +%s)
	interval=$(firmware_auto_interval_seconds)
	stamp=/tmp/veci-firmware-auto-last
	if [ -r "$stamp" ]; then
		read -r last < "$stamp" || last=0
		case "$last" in
			''|*[!0-9]*) last=0 ;;
		esac
		age=$((now - last))
		[ "$age" -lt 0 ] && age=0
		[ "$age" -ge "$interval" ] || return 1
	fi
	printf '%s\n' "$now" > "$stamp"
	return 0
}

firmware_auto_download_enabled() {
	[ "$(uci -q get veci.main.firmware_auto_download 2>/dev/null)" = "1" ]
}

firmware_auto_install_enabled() {
	[ "$(uci -q get veci.main.firmware_auto_install 2>/dev/null)" = "1" ]
}

valid_https_url() {
	case "$1" in
		https://*) return 0 ;;
		*) return 1 ;;
	esac
}

load_firmware_metadata() {
	channel_url=$(firmware_channel_url)
	[ -n "$channel_url" ] && valid_https_url "$channel_url" || return 10
	command -v wget >/dev/null 2>&1 || return 11

	metadata=/tmp/veci-firmware-channel.json
	wget -qO "$metadata" "$channel_url" || return 12

	firmware_metadata_signed=false
	sig_url=$(firmware_channel_sig_url)
	pubkey=$(firmware_channel_pubkey)
	if [ -n "$sig_url" ] || [ -n "$pubkey" ]; then
		[ -n "$sig_url" ] && [ -n "$pubkey" ] || return 19
		valid_https_url "$sig_url" || return 20
		[ -r "$pubkey" ] && command -v usign >/dev/null 2>&1 || return 21
		signature=/tmp/veci-firmware-channel.sig
		wget -qO "$signature" "$sig_url" || return 22
		usign -V -p "$pubkey" -m "$metadata" -x "$signature" >/dev/null 2>&1 || return 23
		firmware_metadata_signed=true
	fi
	schema=$(jsonfilter -i "$metadata" -e '@.schema' 2>/dev/null)
	firmware_board=$(jsonfilter -i "$metadata" -e '@.board' 2>/dev/null)
	firmware_version=$(jsonfilter -i "$metadata" -e '@.version' 2>/dev/null)
	firmware_build_id=$(jsonfilter -i "$metadata" -e '@.build_id' 2>/dev/null)
	firmware_url=$(jsonfilter -i "$metadata" -e '@.firmware.url' 2>/dev/null)
	firmware_sha256=$(jsonfilter -i "$metadata" -e '@.firmware.sha256' 2>/dev/null | tr 'A-F' 'a-f')
	firmware_bytes=$(jsonfilter -i "$metadata" -e '@.firmware.bytes' 2>/dev/null)
	firmware_notes=$(jsonfilter -i "$metadata" -e '@.release_notes' 2>/dev/null)
	live_board=$(firmware_live_board)

	[ "$schema" = "1" ] || return 13
	[ -n "$live_board" ] && [ "$firmware_board" = "$live_board" ] || return 14
	safe_build_id=$(clean_token "$firmware_build_id")
	[ -n "$firmware_build_id" ] && [ "$safe_build_id" = "$firmware_build_id" ] || return 24
	valid_https_url "$firmware_url" || return 15
	case "$firmware_sha256" in
		????????????????????????????????????????????????????????????????) ;;
		*) return 16 ;;
	esac
	printf '%s' "$firmware_sha256" | grep -Eq '^[0-9a-f]{64}$' || return 16
	case "$firmware_bytes" in
		''|*[!0-9]*) return 17 ;;
	esac
	max_bytes=$(firmware_max_bytes)
	if [ "$max_bytes" -gt 0 ] 2>/dev/null && [ "$firmware_bytes" -gt "$max_bytes" ] 2>/dev/null; then
		return 18
	fi
	return 0
}

firmware_metadata_error() {
	case "$1" in
		10) printf 'channel_not_configured' ;;
		11) printf 'downloader_unavailable' ;;
		12) printf 'channel_fetch_failed' ;;
		13) printf 'unsupported_channel_schema' ;;
		14) printf 'board_mismatch' ;;
		15) printf 'invalid_firmware_url' ;;
		16) printf 'invalid_firmware_checksum' ;;
		17) printf 'invalid_firmware_size' ;;
		18) printf 'firmware_too_large' ;;
		19) printf 'incomplete_signature_config' ;;
		20) printf 'invalid_signature_url' ;;
		21) printf 'signature_verifier_unavailable' ;;
		22) printf 'signature_fetch_failed' ;;
		23) printf 'metadata_signature_invalid' ;;
		24) printf 'invalid_build_id' ;;
		*) printf 'invalid_firmware_metadata' ;;
	esac
}

firmware_image_path() {
	printf '/tmp/veci-sysupgrade.bin'
}

firmware_state_path() {
	printf '/tmp/veci-sysupgrade.ready'
}

method_firmware_upload_start() {
	image=$(firmware_image_path)
	state=$(firmware_state_path)
	rm -f "$image" "$state" /tmp/veci-upload-chunk.bin
	: > "$image" || {
		printf '{ "ok": false, "error": "upload_init_failed" }\n'
		return
	}
	max_bytes=$(firmware_max_bytes)
	[ "$max_bytes" -gt 0 ] 2>/dev/null || max_bytes=16777216
	printf '{ "ok": true, "chunk_bytes": 32768, "max_bytes": %s }\n' "$max_bytes"
}

method_firmware_upload_chunk() {
	input=$(cat)
	offset=$(printf '%s' "$input" | jsonfilter -e '@.offset' 2>/dev/null)
	data=$(printf '%s' "$input" | jsonfilter -e '@.data' 2>/dev/null)
	case "$offset" in
		''|*[!0-9]*) printf '{ "ok": false, "error": "invalid_upload_offset" }\n'; return ;;
	esac
	[ -n "$data" ] || {
		printf '{ "ok": false, "error": "empty_upload_chunk" }\n'
		return
	}

	image=$(firmware_image_path)
	[ -f "$image" ] || {
		printf '{ "ok": false, "error": "upload_not_started" }\n'
		return
	}
	current=$(wc -c < "$image" | tr -d '[:space:]')
	[ "$current" = "$offset" ] || {
		printf '{ "ok": false, "error": "upload_offset_mismatch", "expected": %s }\n' "$current"
		return
	}

	chunk=/tmp/veci-upload-chunk.bin
	if ! printf '%s' "$data" | base64 -d > "$chunk" 2>/dev/null; then
		rm -f "$chunk"
		printf '{ "ok": false, "error": "invalid_upload_chunk" }\n'
		return
	fi
	chunk_bytes=$(wc -c < "$chunk" | tr -d '[:space:]')
	[ "$chunk_bytes" -gt 0 ] 2>/dev/null && [ "$chunk_bytes" -le 32768 ] 2>/dev/null || {
		rm -f "$chunk"
		printf '{ "ok": false, "error": "upload_chunk_too_large" }\n'
		return
	}

	max_bytes=$(firmware_max_bytes)
	[ "$max_bytes" -gt 0 ] 2>/dev/null || max_bytes=16777216
	next=$((current + chunk_bytes))
	[ "$next" -le "$max_bytes" ] || {
		rm -f "$chunk" "$image"
		printf '{ "ok": false, "error": "firmware_too_large" }\n'
		return
	}

	cat "$chunk" >> "$image" || {
		rm -f "$chunk" "$image"
		printf '{ "ok": false, "error": "upload_write_failed" }\n'
		return
	}
	rm -f "$chunk"
	printf '{ "ok": true, "next_offset": %s }\n' "$next"
}

method_firmware_upload_finish() {
	input=$(cat)
	expected_bytes=$(printf '%s' "$input" | jsonfilter -e '@.bytes' 2>/dev/null)
	expected_sha=$(printf '%s' "$input" | jsonfilter -e '@.sha256' 2>/dev/null | tr 'A-F' 'a-f')
	case "$expected_bytes" in
		''|*[!0-9]*) printf '{ "ok": false, "error": "invalid_firmware_size" }\n'; return ;;
	esac
	printf '%s' "$expected_sha" | grep -Eq '^[0-9a-f]{64}$' || {
		printf '{ "ok": false, "error": "invalid_firmware_checksum" }\n'
		return
	}

	image=$(firmware_image_path)
	state=$(firmware_state_path)
	[ -f "$image" ] || {
		printf '{ "ok": false, "error": "upload_not_started" }\n'
		return
	}
	actual_bytes=$(wc -c < "$image" | tr -d '[:space:]')
	[ "$actual_bytes" = "$expected_bytes" ] || {
		rm -f "$image"
		printf '{ "ok": false, "error": "firmware_size_mismatch" }\n'
		return
	}
	actual_sha=$(sha256sum "$image" 2>/dev/null | awk '{ print $1 }' | tr 'A-F' 'a-f')
	[ "$actual_sha" = "$expected_sha" ] || {
		rm -f "$image"
		printf '{ "ok": false, "error": "firmware_checksum_mismatch" }\n'
		return
	}
	if ! sysupgrade -T "$image" >/tmp/veci-sysupgrade-test.log 2>&1; then
		rm -f "$image" "$state"
		printf '{ "ok": false, "error": "sysupgrade_validation_failed" }\n'
		return
	fi

	printf '%s %s %s %s %s %s\n' 'manual-upload' "$actual_sha" "$actual_bytes" 'manual' 'false' 'manual-upload' > "$state"
	printf '{ "ok": true, "ready": true, "version": "manual-upload", "sha256": "%s", "bytes": %s }\n' "$actual_sha" "$actual_bytes"
}

method_firmware_apply() {
	firmware_apply_enabled || {
		printf '{ "ok": false, "error": "firmware_apply_disabled" }\n'
		return
	}

	image=$(firmware_image_path)
	state=$(firmware_state_path)
	[ -r "$image" ] && [ -r "$state" ] || {
		printf '{ "ok": false, "error": "firmware_not_ready" }\n'
		return
	}
	read -r version expected_sha expected_bytes source signed build_id < "$state" || {
		printf '{ "ok": false, "error": "firmware_state_invalid" }\n'
		return
	}
	if [ "$source" = "channel" ] && [ "$signed" != "true" ]; then
		printf '{ "ok": false, "error": "unsigned_channel_metadata" }\n'
		return
	fi

	actual_bytes=$(wc -c < "$image" | tr -d '[:space:]')
	actual_sha=$(sha256sum "$image" 2>/dev/null | awk '{ print $1 }' | tr 'A-F' 'a-f')
	[ "$actual_bytes" = "$expected_bytes" ] && [ "$actual_sha" = "$expected_sha" ] || {
		rm -f "$state"
		printf '{ "ok": false, "error": "firmware_ready_check_failed" }\n'
		return
	}
	if ! sysupgrade -T "$image" >/tmp/veci-sysupgrade-test.log 2>&1; then
		rm -f "$state"
		printf '{ "ok": false, "error": "sysupgrade_validation_failed" }\n'
		return
	fi

	[ ! -e /tmp/veci-sysupgrade.applying ] || {
		printf '{ "ok": false, "error": "firmware_apply_in_progress" }\n'
		return
	}
	: > /tmp/veci-sysupgrade.applying
	rm -f "$state"
	(
		sleep 1
		sysupgrade "$image" >/tmp/veci-sysupgrade-apply.log 2>&1
	) &
	printf '{ "ok": true, "rebooting": true }\n'
}

method_firmware_auto_tick() {
	firmware_auto_check_enabled || {
		printf '{ "ok": true, "action": "disabled" }\n'
		return
	}

	firmware_auto_due || {
		printf '{ "ok": true, "action": "not_due" }\n'
		return
	}

	load_firmware_metadata
	rc=$?
	if [ "$rc" -ne 0 ]; then
		error=$(firmware_metadata_error "$rc")
		printf '{ "ok": false, "error": "%s" }\n' "$error"
		return
	fi

	current_build_id=$(firmware_current_build_id)
	safe_current=$(clean_token "$current_build_id")
	[ -n "$current_build_id" ] && [ "$safe_current" = "$current_build_id" ] || {
		printf '{ "ok": false, "error": "current_build_unknown" }\n'
		return
	}

	if [ "$current_build_id" = "$firmware_build_id" ]; then
		printf '{ "ok": true, "action": "up_to_date", "build_id": "%s" }\n' "$safe_current"
		return
	fi

	firmware_auto_download_enabled || {
		printf '{ "ok": true, "action": "update_available", "version": "%s", "build_id": "%s" }\n' \
			"$(clean_token "$firmware_version")" "$firmware_build_id"
		return
	}

	[ "$firmware_metadata_signed" = true ] || {
		printf '{ "ok": false, "error": "unsigned_channel_metadata" }\n'
		return
	}

	result=/tmp/veci-auto-download-result.json
	method_firmware_download > "$result"
	state=$(firmware_state_path)
	if [ ! -r "$state" ]; then
		error=$(jsonfilter -i "$result" -e '@.error' 2>/dev/null)
		[ -n "$error" ] || error='firmware_download_failed'
		printf '{ "ok": false, "error": "%s" }\n' "$(clean_token "$error")"
		return
	fi

	read -r version expected_sha expected_bytes source signed staged_build_id < "$state" || {
		printf '{ "ok": false, "error": "firmware_state_invalid" }\n'
		return
	}
	[ "$source" = "channel" ] && [ "$signed" = "true" ] && [ "$staged_build_id" = "$firmware_build_id" ] || {
		method_firmware_cancel >/dev/null
		printf '{ "ok": false, "error": "staged_firmware_identity_mismatch" }\n'
		return
	}

	firmware_auto_install_enabled || {
		printf '{ "ok": true, "action": "downloaded", "version": "%s", "build_id": "%s" }\n' \
			"$(clean_token "$version")" "$(clean_token "$staged_build_id")"
		return
	}

	firmware_apply_enabled || {
		printf '{ "ok": false, "error": "firmware_apply_disabled" }\n'
		return
	}

	method_firmware_apply
}

method_firmware_cancel() {
	rm -f "$(firmware_image_path)" "$(firmware_state_path)" /tmp/veci-upload-chunk.bin /tmp/veci-sysupgrade-test.log
	printf '{ "ok": true }\n'
}

method_firmware_check() {
	load_firmware_metadata
	rc=$?
	if [ "$rc" -ne 0 ]; then
		error=$(firmware_metadata_error "$rc")
		printf '{ "ok": false, "error": "%s" }\n' "$error"
		return
	fi

	. /usr/share/libubox/jshn.sh
	json_init
	json_add_boolean ok 1
	json_add_string board "$firmware_board"
	json_add_string version "$firmware_version"
	json_add_string build_id "$firmware_build_id"
	current_build_id=$(firmware_current_build_id)
	json_add_string current_build_id "$(clean_token "$current_build_id")"
	if [ -n "$current_build_id" ] && [ "$current_build_id" = "$firmware_build_id" ]; then
		json_add_boolean update_available 0
	else
		json_add_boolean update_available 1
	fi
	json_add_string url "$firmware_url"
	json_add_string sha256 "$firmware_sha256"
	json_add_int bytes "$firmware_bytes"
	[ "$firmware_metadata_signed" = true ] && json_add_boolean signed 1 || json_add_boolean signed 0
	json_add_string release_notes "$firmware_notes"
	json_dump
}

method_firmware_download() {
	load_firmware_metadata
	rc=$?
	if [ "$rc" -ne 0 ]; then
		error=$(firmware_metadata_error "$rc")
		printf '{ "ok": false, "error": "%s" }\n' "$error"
		return
	fi

	image=/tmp/veci-sysupgrade.bin
	state=/tmp/veci-sysupgrade.ready
	rm -f "$image" "$state"
	wget -qO "$image" "$firmware_url" || {
		rm -f "$image"
		printf '{ "ok": false, "error": "firmware_download_failed" }\n'
		return
	}

	actual_bytes=$(wc -c < "$image" | tr -d '[:space:]')
	[ "$actual_bytes" = "$firmware_bytes" ] || {
		rm -f "$image"
		printf '{ "ok": false, "error": "firmware_size_mismatch" }\n'
		return
	}
	actual_sha256=$(sha256sum "$image" 2>/dev/null | awk '{ print $1 }' | tr 'A-F' 'a-f')
	[ "$actual_sha256" = "$firmware_sha256" ] || {
		rm -f "$image"
		printf '{ "ok": false, "error": "firmware_checksum_mismatch" }\n'
		return
	}

	if ! sysupgrade -T "$image" >/tmp/veci-sysupgrade-test.log 2>&1; then
		rm -f "$image"
		printf '{ "ok": false, "error": "sysupgrade_validation_failed" }\n'
		return
	fi

	printf '%s %s %s %s %s %s\n' "$firmware_version" "$firmware_sha256" "$actual_bytes" 'channel' "$firmware_metadata_signed" "$firmware_build_id" > "$state"
	printf '{ "ok": true, "ready": true, "version": "%s", "sha256": "%s", "bytes": %s }\n' \
		"$(clean_token "$firmware_version")" "$firmware_sha256" "$actual_bytes"
}

method_firmware_ready() {
	image=/tmp/veci-sysupgrade.bin
	state=/tmp/veci-sysupgrade.ready
	[ -r "$image" ] && [ -r "$state" ] || {
		printf '{ "ready": false }\n'
		return
	}
	read -r version expected_sha expected_bytes source signed build_id < "$state" || {
		printf '{ "ready": false }\n'
		return
	}
	actual_bytes=$(wc -c < "$image" | tr -d '[:space:]')
	actual_sha=$(sha256sum "$image" 2>/dev/null | awk '{ print $1 }' | tr 'A-F' 'a-f')
	if [ "$actual_bytes" = "$expected_bytes" ] && [ "$actual_sha" = "$expected_sha" ]; then
		apply_enabled=false
		firmware_apply_enabled && apply_enabled=true
		printf '{ "ready": true, "version": "%s", "build_id": "%s", "sha256": "%s", "bytes": %s, "source": "%s", "signed": %s, "apply_enabled": %s }\n' \
			"$(clean_token "$version")" "$(clean_token "$build_id")" "$actual_sha" "$actual_bytes" "$(clean_token "$source")" "$signed" "$apply_enabled"
	else
		rm -f "$image" "$state"
		printf '{ "ready": false }\n'
	fi
}

method_diagnostic() {
	input=$(cat)
	tool=$(printf '%s' "$input" | jsonfilter -e '@.tool' 2>/dev/null)
	target=$(printf '%s' "$input" | jsonfilter -e '@.target' 2>/dev/null)
	safe_target=$(clean_token "$target")

	[ -n "$target" ] && [ "$safe_target" = "$target" ] && [ "${#target}" -le 253 ] || {
		printf '{ "ok": false, "error": "invalid_target" }\n'
		return
	}

	case "$tool" in
		ping)
			output=$(ping -c 4 -W 2 "$target" 2>&1)
			rc=$?
			;;
		traceroute)
			command -v traceroute >/dev/null 2>&1 || {
				printf '{ "ok": false, "error": "traceroute_not_available" }\n'
				return
			}
			output=$(traceroute -m 10 -w 1 -q 1 "$target" 2>&1)
			rc=$?
			;;
		*)
			printf '{ "ok": false, "error": "tool_not_allowed" }\n'
			return
			;;
	esac

	output=$(printf '%s\n' "$output" | sed -n '1,30p')
	. /usr/share/libubox/jshn.sh
	json_init
	[ "$rc" -eq 0 ] && json_add_boolean ok 1 || json_add_boolean ok 0
	json_add_string tool "$tool"
	json_add_string target "$target"
	json_add_string output "$output"
	json_dump
}

root_password_is_set() {
	hash=$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow 2>/dev/null)
	case "$hash" in
		''|'!'|'*'|'!!') return 1 ;;
		*) return 0 ;;
	esac
}

method_security_status() {
	if root_password_is_set; then
		printf '{ "root_password_set": true }\n'
	else
		printf '{ "root_password_set": false }\n'
	fi
}

method_set_admin_password() {
	root_password_is_set && {
		printf '{ "ok": false, "error": "password_already_set" }\n'
		return
	}

	input=$(cat)
	password=$(printf '%s' "$input" | jsonfilter -e '@.password' 2>/dev/null)
	length=${#password}
	flat_password=$(printf '%s' "$password" | tr -d '\r\n')

	[ "$flat_password" = "$password" ] || {
		printf '{ "ok": false, "error": "password_characters" }\n'
		return
	}

	[ "$length" -ge 8 ] && [ "$length" -le 72 ] || {
		printf '{ "ok": false, "error": "password_length" }\n'
		return
	}

	LC_ALL=C printf '%s' "$password" | grep -q '^[ -~]*$' || {
		printf '{ "ok": false, "error": "password_characters" }\n'
		return
	}

	command -v passwd >/dev/null 2>&1 || {
		printf '{ "ok": false, "error": "passwd_not_available" }\n'
		return
	}

	if printf '%s\n%s\n' "$password" "$password" | passwd root >/dev/null 2>&1; then
		printf '{ "ok": true }\n'
	else
		printf '{ "ok": false, "error": "password_change_failed" }\n'
	fi
}

method_service_action() {
	input=$(cat)
	service=$(printf '%s' "$input" | jsonfilter -e '@.service')
	action=$(printf '%s' "$input" | jsonfilter -e '@.action')

	case "$service" in
		network|firewall|dnsmasq|uhttpd|opennds) ;;
		*) printf '{ "ok": false, "error": "service_not_allowed" }\n'; return ;;
	esac

	case "$action" in
		start|stop|restart|reload) ;;
		*) printf '{ "ok": false, "error": "action_not_allowed" }\n'; return ;;
	esac

	script="/etc/init.d/$service"
	[ -x "$script" ] || {
		printf '{ "ok": false, "error": "service_not_installed" }\n'
		return
	}

	if "$script" "$action" >/dev/null 2>&1; then
		printf '{ "ok": true }\n'
	else
		printf '{ "ok": false, "error": "service_action_failed" }\n'
	fi
}

method_wifi_reload() {
	if ! command -v wifi >/dev/null 2>&1; then
		printf '{ "ok": false, "error": "wifi_command_not_found" }\n'
		return
	fi
	if wifi reload >/dev/null 2>&1; then
		printf '{ "ok": true }\n'
	else
		printf '{ "ok": false, "error": "wifi_reload_failed" }\n'
	fi
}

case "$1" in
	list)
		printf '{ "capabilities": {}, "clients": {}, "networkInventory": {}, "health": {}, "internetStatus": {}, "updateStatus": {}, "apps": {}, "appAction": { "id": "str", "action": "str" }, "firmwareCheck": {}, "firmwareDownload": {}, "firmwareReady": {}, "firmwareUploadStart": {}, "firmwareUploadChunk": { "offset": "int", "data": "str" }, "firmwareUploadFinish": { "bytes": "int", "sha256": "str" }, "firmwareApply": {}, "firmwareAutoTick": {}, "firmwareCancel": {}, "securityStatus": {}, "setAdminPassword": { "password": "str" }, "diagnostic": { "tool": "str", "target": "str" }, "serviceAction": { "service": "str", "action": "str" }, "wifiReload": {} }\n'
		;;
	call)
		case "$2" in
			capabilities) method_capabilities ;;
			clients) method_clients ;;
			networkInventory) method_network_inventory ;;
			health) method_health ;;
			internetStatus) method_internet_status ;;
			updateStatus) method_update_status ;;
			apps) method_apps ;;
			appAction) method_app_action ;;
			firmwareCheck) method_firmware_check ;;
			firmwareDownload) method_firmware_download ;;
			firmwareReady) method_firmware_ready ;;
			firmwareUploadStart) method_firmware_upload_start ;;
			firmwareUploadChunk) method_firmware_upload_chunk ;;
			firmwareUploadFinish) method_firmware_upload_finish ;;
			firmwareApply) method_firmware_apply ;;
			firmwareAutoTick) method_firmware_auto_tick ;;
			firmwareCancel) method_firmware_cancel ;;
			securityStatus) method_security_status ;;
			setAdminPassword) method_set_admin_password ;;
			diagnostic) method_diagnostic ;;
			serviceAction) method_service_action ;;
			wifiReload) method_wifi_reload ;;
			*) printf '{ "error": "method_not_found" }\n' ;;
		esac
		;;
esac
